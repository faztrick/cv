# Copy this file to .env and fill values as needed.

# AI provider (OpenAI-compatible — works with OpenAI, LM Studio, Ollama, etc.)
# LM Studio (local): set BASE_URL to http://localhost:1234/v1, leave API_KEY empty
# OpenAI (cloud):    set BASE_URL to https://api.openai.com/v1, set API_KEY
OPENAI_API_KEY=
OPENAI_MODEL=qwen/qwen3.5-9b
OPENAI_BASE_URL=http://localhost:1234/v1

# Indeed automation (optional)
INDEED_EMAIL=
INDEED_PASSWORD=

# LinkedIn automation (optional)
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# Email automation (optional)
# For Gmail, use an App Password (not your normal password)
GMAIL_SENDER_EMAIL=
GMAIL_APP_PASSWORD=

# WhatsApp (optional)
# Sending is done via the local panel server at http://localhost:3000
WHATSAPP_DEFAULT_NUMBER=

# Browser profile directory for automation (optional)
CHROME_USER_DATA_DIR=

# Local admin panel protection (required if you use npm run panel)
ADMIN_PASSWORD=
# Optional but recommended to avoid predictable local session signing
ADMIN_SESSION_SECRET=
# Optional second prompt on the local admin login page
ADMIN_SECURITY_QUESTION=
ADMIN_SECURITY_ANSWER=

# Azure (only if you use Azure deployment scripts)
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Azure AD / Microsoft Authenticator MFA for admin login (optional)
# Register an app in Azure Portal → App registrations, then fill these in.
# Set the redirect URI in Azure to: http://localhost:3000/api/admin/auth/azure/callback
# AZURE_AD_ADMIN_EMAILS is a comma-separated list of Microsoft account emails allowed to log in as admin.
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_REDIRECT_URI=http://localhost:3000/api/admin/auth/azure/callback
AZURE_AD_ADMIN_EMAILS=
