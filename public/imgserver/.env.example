# Environment Configuration
NODE_ENV=production

# Server Ports
HTTP_PORT=80
HTTPS_PORT=443

# Azure Blob Storage Configuration (optional — uses local disk when not set)
# Option 1: Connection string (recommended)
AZURE_STORAGE_CONNECTION_STRING=
# Option 2: Account name + key
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
# Container name (default: images)
AZURE_STORAGE_CONTAINER=images

# Domain Configuration
APP_DOMAIN=uaecodes.com

# API Configuration
MAX_FILE_SIZE=30mb
