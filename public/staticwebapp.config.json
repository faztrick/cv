{
    "navigationFallback":  {
                               "rewrite":  "/index.html",
                               "exclude":  [
                                               "/callcenter/*",
                                               "/callcenter"
                                           ]
                           },
    "routes":  [
                   {
                       "route":  "/callcenter",
                       "redirect":  "/callcenter/",
                       "statusCode":  301
                   },
                                           {
                                               "route": "/admin-panel",
                                               "redirect": "/admin-panel.html",
                                               "statusCode": 301
                                           },
                                           {
                                               "route": "/admin-panel.html",
                                               "allowedRoles": [
                                                   "admin"
                                               ]
                                           },
                   {
                       "route":  "/assets/*",
                       "headers":  {
                                       "cache-control":  "public, max-age=31536000, immutable"
                                   }
                   }
               ],
                            "responseOverrides": {
                                                     "401": {
                                                                 "statusCode": 302,
                                                                 "redirect": "/.auth/login/aad?post_login_redirect_uri=/admin-panel.html"
                                                             },
                                                     "403": {
                                                                 "statusCode": 302,
                                                                 "redirect": "/"
                                                             }
                                                 },
    "globalHeaders":  {
                          "X-Content-Type-Options":  "nosniff",
                          "X-Frame-Options":  "DENY",
                          "X-XSS-Protection":  "1; mode=block"
                      },
    "mimeTypes":  {
                      ".json":  "application/json",
                      ".css":  "text/css",
                      ".js":  "text/javascript",
                      ".html":  "text/html",
                      ".ico":  "image/x-icon",
                      ".svg":  "image/svg+xml"
                  }
}