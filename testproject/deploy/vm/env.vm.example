# Copy this file to the repo root as .env.vm
#   cp deploy/vm/env.vm.example .env.vm
#
# Then deploy:
#   docker compose --env-file ./.env.vm -f docker-compose.vm.yml up -d --build
#   docker compose --env-file ./.env.vm -f docker-compose.vm.yml --profile init run --rm db-init
#
# Replace <VM_IP_OR_DOMAIN> with your VM public IP or domain.

# Postgres
POSTGRES_DB=cv
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# API (container talks to Postgres via service name "db")
DATABASE_URL=postgresql://postgres:postgres@db:5432/cv?schema=public
JWT_SECRET=change-me-now
SUBSCRIPTION_PRICE_CENTS=0

# CORS allowlist: should match what browsers use to load your frontend
WEB_ORIGIN=http://<VM_IP_OR_DOMAIN>

# The web build bakes this into the client bundle.
# If you use nginx in this compose, the API is available at /api.
NEXT_PUBLIC_API_URL=http://<VM_IP_OR_DOMAIN>/api

# API port inside the VM network (nginx proxies to it)
API_PORT=4000

# Leave empty to store uploads on the VM volume ./vm_data/uploads
UPLOADS_BUCKET=

# Optional: seed user overrides
# SEED_ADMIN_EMAIL=admin@fanhouse.test
# SEED_ADMIN_PASSWORD=admin123
# SEED_FAN_EMAIL=fan@fanhouse.test
# SEED_FAN_PASSWORD=fan123
# SEED_CREATOR_EMAIL=creator@fanhouse.test
# SEED_CREATOR_PASSWORD=creator123
