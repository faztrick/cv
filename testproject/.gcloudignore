# Ignore large / generated / local-only files when uploading source to Google Cloud Build.
# This dramatically reduces the "Uploading source" time.

# Node
**/node_modules/
**/npm-debug.log
**/yarn-debug.log
**/yarn-error.log

# Builds / outputs
build/
dist/
**/dist/
**/.next/
**/out/

# Local uploads / VM data (not needed in Cloud Build)
apps/api/uploads/
vm_data/

# Flutter
**/.dart_tool/
**/build/
flutter_frontend/.dart_tool/
flutter_frontend/build/

# Tooling
.vscode/
.idea/
.DS_Store

# Secrets / local env
**/.env
**/.env.*

# Git
.git/
