generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAN
  CREATOR
  ADMIN
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PriceType {
  FREE
  SUBSCRIBER
  PPV
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
}

enum LedgerType {
  SUBSCRIPTION
  PPV
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique
  passwordHash  String
  role          Role             @default(FAN)
  createdAt     DateTime         @default(now())
  creator       CreatorProfile?
  notifications Notification[]
  subscriptions Subscription[]  @relation("FanSubscriptions")
  ppvUnlocks    PpvUnlock[]
}

model CreatorProfile {
  id           String        @id @default(cuid())
  userId       String        @unique
  displayName  String
  bio          String?
  status       CreatorStatus @default(PENDING)
  isDisabled   Boolean       @default(false)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id])
  posts        Post[]
  subscribers  Subscription[] @relation("CreatorSubscriptions")
}

model Post {
  id         String     @id @default(cuid())
  creatorId  String
  title      String
  body       String
  priceType  PriceType  @default(SUBSCRIBER)
  priceCents Int        @default(0)
  isDisabled Boolean    @default(false)
  createdAt  DateTime   @default(now())
  creator    CreatorProfile @relation(fields: [creatorId], references: [id])
  media      MediaAsset[]
  ppvUnlocks PpvUnlock[]
}

model MediaAsset {
  id         String   @id @default(cuid())
  postId     String
  storageKey String
  mimeType   String
  createdAt  DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id])
}

model Subscription {
  id         String             @id @default(cuid())
  fanId      String
  creatorId  String
  status     SubscriptionStatus @default(ACTIVE)
  createdAt  DateTime           @default(now())
  fan        User               @relation("FanSubscriptions", fields: [fanId], references: [id])
  creator    CreatorProfile     @relation("CreatorSubscriptions", fields: [creatorId], references: [id])
  @@unique([fanId, creatorId])
}

model PpvUnlock {
  id        String   @id @default(cuid())
  fanId     String
  postId    String
  createdAt DateTime @default(now())
  fan       User     @relation(fields: [fanId], references: [id])
  post      Post     @relation(fields: [postId], references: [id])
  @@unique([fanId, postId])
}

model LedgerEntry {
  id          String    @id @default(cuid())
  fanId       String?
  creatorId   String?
  postId      String?
  type        LedgerType
  amountCents Int
  currency    String    @default("USD")
  metadata    Json?
  createdAt   DateTime  @default(now())
}

model AdminAction {
  id         String   @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  createdAt  DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
