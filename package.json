{
  "name": "cv-job-search-toolkit",
  "version": "1.0.0",
  "description": "CV and job-search toolkit with resume parsing, matching, and outreach utilities for Dubai positions",
  "main": "index.js",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "scripts": "scripts",
    "automation": "automation"
  },
  "scripts": {
    "start": "node index.js",
    "panel": "node server.js",
    "watch": "nodemon server.js",
    "generate-emails": "node scripts/generate-job-emails.js",
    "job-agent": "node scripts/job-search-agent.js",
    "job-search": "node scripts/job-search-agent.js --search",
    "install-puppeteer": "npm install puppeteer",
    "parse-cv": "node scripts/cv-parser.js --sync-data",
    "parse-cv:flutter": "node scripts/cv-parser.js --resume resumes/variants/resume-flutter-fullstack.md --sync-data",
    "parse-cv:react": "node scripts/cv-parser.js --resume resumes/variants/resume-react-fullstack.md --sync-data",
    "parse-cv:dotnet": "node scripts/cv-parser.js --resume resumes/variants/resume-dotnet-fullstack.md --sync-data",
    "parse-cv:node": "node scripts/cv-parser.js --resume resumes/variants/resume-nodejs-backend.md --sync-data",
    "outreach": "node scripts/outreach-manager.js",
    "auto-fill": "node scripts/universal-auto-fill.js",
    "smart-email": "node scripts/smart-email-generator.js generate",
    "email-variants": "node scripts/smart-email-generator.js variants",
    "batch-emails": "node scripts/smart-email-generator.js batch",
    "apply-pack": "node scripts/apply-pack.js",
    "job-pack": "node scripts/job-pack.js",
    "automate": "node scripts/automate.js",
    "mcp:job-agent": "node mcp/job-agent-server.mjs",
    "fanhouse:typeform": "node automation/fanhouse-typeform/fill-typeform.js"
  },
  "keywords": [
    "job-search",
    "email-automation",
    "resume",
    "cv",
    "dubai",
    "career",
    "puppeteer",
    "web-scraping",
    "auto-fill",
    "cv-parser",
    "job-matching",
    "ai-powered"
  ],
  "author": "Muhammed Fasil PV <faztrick@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "dompurify": "^3.4.16",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "ipaddr.js": "^2.5.0",
    "openai": "^6.10.0",
    "playwright": "^1.57.0",
    "puppeteer-core": "^25.12.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.7"
  },
  "optionalDependencies": {
    "puppeteer": "^25.12.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  },
  "overrides": {
    "whatsapp-web.js": {
      "puppeteer": "$puppeteer"
    }
  }
}
