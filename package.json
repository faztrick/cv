{
  "name": "cv-job-search-toolkit",
  "version": "1.0.0",
  "description": "AI-powered job search toolkit with CV-based auto-fill, smart matching, automated applications, and personalized email generation for Dubai positions",
  "main": "index.js",
  "type": "commonjs",
  "directories": {
    "doc": "docs",
    "scripts": "scripts",
    "automation": "automation"
  },
  "scripts": {
    "start": "node index.js",
    "panel": "node server.js",
    "watch": "nodemon server.js",
    "generate-emails": "node scripts/generate-job-emails.js",
    "job-agent": "node scripts/job-search-agent.js",
    "job-search": "node scripts/job-search-agent.js --search",
    "clean-cache": "node scripts/delete-puppeteer-cache.js",
    "install-puppeteer": "npm install puppeteer",
    "parse-cv": "node scripts/cv-parser.js --sync-data",
    "parse-cv:flutter": "node scripts/cv-parser.js --resume resumes/variants/resume-flutter-fullstack.md --sync-data",
    "parse-cv:react": "node scripts/cv-parser.js --resume resumes/variants/resume-react-fullstack.md --sync-data",
    "parse-cv:dotnet": "node scripts/cv-parser.js --resume resumes/variants/resume-dotnet-fullstack.md --sync-data",
    "parse-cv:node": "node scripts/cv-parser.js --resume resumes/variants/resume-nodejs-backend.md --sync-data",
    "indeed-search": "node scripts/indeed-auto-apply.js search",
    "indeed-apply": "node scripts/indeed-auto-apply.js apply",
    "indeed-stats": "node scripts/indeed-auto-apply.js stats",
    "indeed-update-profile": "node scripts/indeed-auto-apply.js update-profile",
    "linkedin-search": "node scripts/linkedin-auto-apply.js search",
    "linkedin-apply": "node scripts/linkedin-auto-apply.js apply",
    "linkedin-update-profile": "node scripts/linkedin-auto-apply.js update-profile",
    "playwright-indeed": "node scripts/job-search-playwright.js indeed",
    "playwright-linkedin": "node scripts/job-search-playwright.js linkedin",
    "playwright-dubizzle": "node scripts/job-search-playwright.js dubizzle",
    "playwright-bayt": "node scripts/job-search-playwright.js bayt",
    "playwright-gulftalent": "node scripts/job-search-playwright.js gulftalent",
    "playwright-naukrigulf": "node scripts/job-search-playwright.js naukrigulf",
    "outreach": "node scripts/outreach-manager.js",
    "auto-fill": "node scripts/universal-auto-fill.js",
    "smart-email": "node scripts/smart-email-generator.js generate",
    "email-variants": "node scripts/smart-email-generator.js variants",
    "batch-emails": "node scripts/smart-email-generator.js batch",
    "apply-pack": "node scripts/apply-pack.js",
    "job-pack": "node scripts/job-pack.js",
    "automate": "node scripts/automate.js",
    "mcp:job-agent": "node mcp/job-agent-server.mjs",
    "fanhouse:typeform": "node automation/fanhouse-typeform/fill-typeform.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "job-search",
    "email-automation",
    "resume",
    "cv",
    "dubai",
    "career",
    "puppeteer",
    "web-scraping",
    "automation",
    "auto-fill",
    "indeed",
    "linkedin",
    "cv-parser",
    "job-matching",
    "ai-powered"
  ],
  "author": "Muhammed Fasil PV <faztrick@gmail.com>",
  "license": "ISC",
  "dependencies": {
    "body-parser": "^2.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "openai": "^6.10.0",
    "playwright": "^1.57.0",
    "puppeteer-core": "^24.32.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "^1.34.2"
  },
  "optionalDependencies": {
    "puppeteer": "^24.32.0"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.11"
  }
}
